  object sdExport: TSaveDialog
    Title = 'Export the radiant submittal'
    DefaultExt = '.pdf'
    Filter = 'PDF (*.pdf)|*.pdf|Text (*.txt)|*.txt'
    Options = [ofOverwritePrompt, ofEnableSizing, ofViewDetail]
    Left = 72
    Top = 8
  end
  object pmZone: TPopupMenu
    OnPopup = pmZonePopup
    Left = 8
    Top = 8
    object miSearchZone: TMenuItem
      Caption = 'Search this zone'
      OnClick = miSearchZoneClick
    end
    object miSearchAll: TMenuItem
      Caption = 'Search all zones'
      OnClick = btnSearchAllClick
    end
    object miNotZone: TMenuItem
      Caption = 'Not a zone - leave it bare'
      OnClick = btnNotZoneClick
    end
    object miBringBack: TMenuItem
      Caption = 'Bring back the shapes left out'
      OnClick = btnBringBackClick
    end
    object miRotate: TMenuItem
      Caption = 'Rotate manifold 90 degrees'
      OnClick = miRotateClick
    end
    object miFace: TMenuItem
      Caption = 'Square the manifold'
      object miFaceEW: TMenuItem
        Caption = 'Long side east - west'
        OnClick = miFaceClick
      end
      object miFaceNS: TMenuItem
        Tag = 90
        Caption = 'Long side north - south'
        OnClick = miFaceClick
      end
      object miFace45: TMenuItem
        Tag = 45
        Caption = 'At 45 degrees'
        OnClick = miFaceClick
      end
      object miFace135: TMenuItem
        Tag = 135
        Caption = 'At 135 degrees'
        OnClick = miFaceClick
      end
    end
    object miSep: TMenuItem
      Caption = '-'
    end
    object miClearZone: TMenuItem
      Caption = 'Clear this zone'
      OnClick = miClearZoneClick
    end
    object miClearAll: TMenuItem
      Caption = 'Clear all zones'
      OnClick = miClearAllClick
    end
  end
end
