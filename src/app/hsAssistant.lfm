object AssistantForm: TAssistantForm
  Left = 300
  Height = 700
  Top = 120
  Width = 560
  ActiveControl = memAsk
  Caption = 'Assistant'
  ClientHeight = 700
  ClientWidth = 560
  Constraints.MinHeight = 420
  Constraints.MinWidth = 420
  KeyPreview = True
  OnActivate = FormActivate
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  OnKeyDown = FormKeyDown
  Position = poMainFormCenter
  object pnlTop: TPanel
    Left = 0
    Height = 48
    Top = 0
    Width = 560
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 48
    ClientWidth = 560
    TabOrder = 0
    object lblTitle: TInkLabel
      Left = 12
      Height = 24
      Top = 4
      Width = 200
      AutoSize = False
      VertAlign = ivaCenter
      Caption = 'Assistant'
      Font.Height = -19
      Font.Style = [fsBold]
      ParentFont = False
    end
    object lblWho: TInkLabel
      Tag = 1
      Left = 12
      Height = 18
      Top = 27
      Width = 300
      AutoSize = False
      VertAlign = ivaCenter
      Caption = 'lblWho'
    end
    object chkOnTop: TBGRAThemeCheckBox
      Left = 330
      Height = 26
      Top = 11
      Width = 90
      Anchors = [akTop, akRight]
      Caption = 'On top'
      OnChange = chkOnTopChange
    end
    object btnSettings: TBCButton
      Tag = 2
      Left = 428
      Height = 32
      Top = 8
      Width = 120
      Anchors = [akTop, akRight]
      Caption = 'Settings...'
      OnClick = btnSettingsClick
    end
  end
  object pnlGiven: TPanel
    Left = 0
    Height = 64
    Top = 48
    Width = 560
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 64
    ClientWidth = 560
    TabOrder = 1
    object lblGiven: TInkLabel
      Left = 12
      Height = 18
      Top = 4
      Width = 300
      AutoSize = False
      VertAlign = ivaCenter
      Caption = 'With every question it is given:'
    end
    object chkManual: TBGRAThemeCheckBox
      Left = 12
      Height = 26
      Top = 28
      Width = 120
      Caption = 'the manual'
      OnChange = chkGivenChange
    end
    object chkSheet: TBGRAThemeCheckBox
      Left = 136
      Height = 26
      Top = 28
      Width = 120
      Caption = 'this sheet'
      OnChange = chkGivenChange
    end
    object chkPicked: TBGRAThemeCheckBox
      Left = 260
      Height = 26
      Top = 28
      Width = 140
      Caption = 'what is picked'
      OnChange = chkGivenChange
    end
    object btnShowGiven: TBCButton
      Tag = 2
      Left = 428
      Height = 32
      Top = 24
      Width = 120
      Anchors = [akTop, akRight]
      Caption = 'See it all'
      OnClick = btnShowGivenClick
    end
  end
  object pnlAsk: TPanel
    Left = 0
    Height = 150
    Top = 550
    Width = 560
    Align = alBottom
    BevelOuter = bvNone
    ClientHeight = 150
    ClientWidth = 560
    TabOrder = 3
    object memAsk: TInkCodeMemo
      Left = 12
      Height = 90
      Top = 6
      Width = 536
      Anchors = [akTop, akLeft, akRight, akBottom]
      TabOrder = 0
      TextHint = 'Ask about the sheet, or for a change to it.  Ctrl+Enter sends.'
      WantReturns = True
      WantTabs = False
    end
    object lblStatus: TInkLabel
      Tag = 1
      Left = 12
      Height = 18
      Top = 116
      Width = 280
      Anchors = [akLeft, akRight, akBottom]
      AutoSize = False
      VertAlign = ivaCenter
      Caption = 'lblStatus'
      Ellipsis = True
    end
    object btnClear: TBCButton
      Tag = 2
      Left = 300
      Height = 32
      Top = 108
      Width = 110
      Anchors = [akRight, akBottom]
      Caption = 'Clear'
      OnClick = btnClearClick
    end
    object btnSend: TBCButton
      Tag = 1
      Left = 418
      Height = 32
      Top = 108
      Width = 130
      Anchors = [akRight, akBottom]
      Caption = 'Send'
      OnClick = btnSendClick
    end
  end
  object memChat: TInkMemo
    Left = 0
    Height = 438
    Top = 112
    Width = 560
    Align = alClient
    BorderSpacing.Left = 12
    BorderSpacing.Right = 12
    TabOrder = 2
    WordWrap = True
  end
end
